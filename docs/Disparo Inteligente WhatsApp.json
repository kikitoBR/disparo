      "id": "a18acd74-29e2-4ff4-b652-b5d8ab659122",
      "name": "Formulário de Disparo",
      "webhookId": "bae173ba-0416-441f-837f-48b7780dc39a"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst rawNumbers = input['Lista de Números (um por linha)'] || '';\nconst mensagem = input['Mensagem a ser enviada'] || '';\nconst delayMin = parseInt(input['Intervalo Mínimo (segundos)']) || 15;\nconst delayMax = parseInt(input['Intervalo Máximo (segundos)']) || 40;\n\n// Separa por quebra de linha\nconst linhas = rawNumbers.split('\\n');\nconst listaFormatada = [];\n\nlinhas.forEach(linha => {\n  // Remove tudo que não for dígito\n  let numero = linha.replace(/\\D/g, '');\n  \n  if (numero.length >= 10) {\n    // Se não tiver DDD/DDI 55, adiciona\n    if (numero.length === 10 || numero.length === 11) {\n      numero = '55' + numero;\n    }\n    \n    // Gera um tempo de espera aleatório entre Min e Max para CADA número\n    const delaySorteado = Math.floor(Math.random() * (delayMax - delayMin + 1)) + delayMin;\n    \n    listaFormatada.push({\n      json: {\n        numero: numero,\n        mensagem: mensagem,\n        delaySegundos: delaySorteado\n      }\n    });\n  }\n});\n\nreturn listaFormatada;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
